# Telegram Bot Token (from @BotFather)
BOT_TOKEN=

# URL where the Mini App is hosted / accessible
WEBAPP_URL=http://localhost:7890

# Port for local Express server
PORT=7890

# Enable Dev / Standalone browser mode (allows testing in browser without Telegram auth)
DEV_MODE=true

# Turso Cloud SQLite (for Vercel deployment)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
